#!/usr/bin/env python3
"""Telegram bot for the dashboard: the same verbs as the web page, from a chat.

The bot is just another client of fractal-ctl. It never runs a command
itself: every message becomes a project name plus a verb, is validated
against the registry (projects.json) and forwarded to the control backend on
the loopback interface, exactly like the browser does. What the browser
cannot do, the bot cannot do either.

Why Telegram: the Bot API is free and works by LONG POLLING - the bot pulls
updates from api.telegram.org, so a machine that is only reachable over a
tailnet needs no public address, no webhook, no port forwarding.

Access: only Telegram user IDs listed in FRACTAL_TELEGRAM_USERS get an
answer. Everyone else is ignored (logged once per user). While the list is
empty the bot answers ANY private message with the sender's numeric ID so the
first user can put it into the config; nothing else works in that state.

Commands (project = name from the registry):
    /status                    up/down of every controllable project + machine
    /projects [folder]         folders (registry groups, matched by name or by the
                               directory under ~/projects), or the projects of one;
                               inline buttons switch the chat's context
    /project <project>         chat in the project's context (claude in its root);
                               also the default project for /ask /send /run /task
    /chat [text]               back to the general chat (claude in $HOME)
    /new                       start the current context's conversation over
    /start <project>           run the registry start command, report the result
    /stop <project>            same for stop
    /run <project> [hook]      run a named hook; without a hook: list them
    /send <project> <text>     paste text into the project's agent tmux window
    /ask <project> <question>  headless question; the answer is streamed into
                               one message that is edited while it grows
    /use <project>             the older name of /project
    /task <project> <text>     new task on the project's board (fractal-tasks);
                               plain text starting with "task" or "úkol" does the same
    /tasks [project]           what the board has for you: open questions, work to review
    /help [topic]              built-in text, or $FRACTAL_STATE_DIR/telegram-help.txt
                               if that file exists (write your own, in your language);
                               lines "## <key> | <label>" split it into topics shown
                               as buttons under the overview. "help" alone works too
    <plain text>               the next message of the conversation in the chat's
                               context (fractal-ctl POST /chat, each message resumes
                               the context's last session)

Notifications: every FRACTAL_TELEGRAM_WATCH seconds (0 = off) the bot reads
/ctl/state and tells every allowed user when a project changed between up
and down without a start/stop being in flight - i.e. it died or came back on
its own.

Setup:
    fractal-telegram configure <bot token>     writes the token file (0600)
    fractal-telegram notify <text>             one message to every allowed user
                                               (fractal-task-run uses it)
    fractal-telegram                           run (the systemd unit does this)

The token lives in its own 0600 file (FRACTAL_TELEGRAM_TOKEN_FILE), not in
fractal.env: that file is world-readable by convention and gets pasted into
issues, tmux windows and agent contexts.
"""
import html
import json
import os
import re
import stat
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from fractal_config import CFG, REGISTRY, STATE_DIR, URL, WWW, port  # noqa: E402

API = "https://api.telegram.org/bot{token}/{method}"
CTL = f"http://127.0.0.1:{port('CTL')}"
TASKS = f"http://127.0.0.1:{port('TASKS')}"
TOKEN_FILE = CFG["FRACTAL_TELEGRAM_TOKEN_FILE"]
USERS = {int(u) for u in re.split(r"[\s,]+", CFG["FRACTAL_TELEGRAM_USERS"].strip()) if u.isdigit()}
WATCH = int(CFG["FRACTAL_TELEGRAM_WATCH"] or 0)
DEFAULTS_FILE = os.path.join(STATE_DIR, "telegram-defaults.json")   # chat -> default project
HELP_FILE = os.path.join(STATE_DIR, "telegram-help.txt")             # optional custom /help
CHATS_FILE = os.path.join(STATE_DIR, "telegram-chats.json")          # chat -> {"ctx", "sessions"}

POLL_TIMEOUT = 50          # long poll; Telegram closes at 50 s anyway
TOGGLE_WAIT = 60           # fractal-ctl waits 45 s for the port, add slack
QUERY_WAIT = 600           # same as fractal-ctl QUERY_TIMEOUT
HOOK_WAIT = 1800           # same as fractal-ctl HOOK_TIMEOUT
EDIT_EVERY = 3.0           # seconds between edits of a streaming answer
TG_MAX = 4000              # Telegram cuts at 4096; leave room for the cursor

_token = ""
_seen_strangers: set[int] = set()
_defaults: dict[str, str] = {}
_chats: dict[str, dict] = {}
_chat_turn: dict[str, threading.Lock] = {}     # one chat turn at a time per chat
_lock = threading.Lock()


def log(*a) -> None:
    print(*a, flush=True)


# --- Telegram -----------------------------------------------------------------

def tg(method: str, http_timeout: float = 30, **params) -> dict:
    """One Bot API call. Returns the "result" or raises."""
    body = json.dumps(params).encode()
    req = urllib.request.Request(API.format(token=_token, method=method), data=body,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=http_timeout) as r:
        data = json.load(r)
    if not data.get("ok"):
        raise RuntimeError(data.get("description") or "telegram error")
    return data.get("result")


def chunks(text: str, n: int = TG_MAX) -> list[str]:
    out = []
    while len(text) > n:
        cut = text.rfind("\n", 0, n)
        if cut < n // 2:
            cut = n
        out.append(text[:cut])
        text = text[cut:].lstrip("\n")
    return out + [text]


def say(chat: int, text: str, mono: bool = False, buttons: list | None = None) -> int | None:
    """Send plain text (or a <pre> block); long texts are split. Returns the
    last message id, so a streaming answer can be edited afterwards. buttons:
    rows of (label, callback data), shown under the last part."""
    mid = None
    parts = chunks(text)
    for i, part in enumerate(parts):
        extra = {"reply_markup": keyboard(buttons)} if buttons and i == len(parts) - 1 else {}
        if mono:
            r = tg("sendMessage", chat_id=chat, text=f"<pre>{html.escape(part)}</pre>", parse_mode="HTML", **extra)
        else:
            r = tg("sendMessage", chat_id=chat, text=part, **extra)
        mid = r.get("message_id")
    return mid


def keyboard(rows: list) -> dict:
    return {"inline_keyboard": [[{"text": t, "callback_data": d} for t, d in row] for row in rows]}


def edit(chat: int, mid: int, text: str, buttons: list | None = None) -> None:
    extra = {"reply_markup": keyboard(buttons)} if buttons else {}
    try:
        tg("editMessageText", chat_id=chat, message_id=mid, text=text[:TG_MAX + 90], **extra)
    except RuntimeError as e:
        if "not modified" not in str(e):
            raise


# --- fractal-ctl --------------------------------------------------------------

def ctl(method: str, path: str, body: dict | None = None, timeout: float = 30) -> tuple[int, dict]:
    return _api(CTL, "fractal-ctl", method, path, body, timeout)


def tasks_api(method: str, path: str, body: dict | None = None, timeout: float = 30) -> tuple[int, dict]:
    return _api(TASKS, "fractal-tasks", method, path, body, timeout)


def _api(base: str, who: str, method: str, path: str, body: dict | None, timeout: float) -> tuple[int, dict]:
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(base + path, data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.load(e)
        except Exception:                                     # noqa: BLE001
            return e.code, {"error": str(e)}
    except (urllib.error.URLError, OSError) as e:
        return 0, {"error": f"{who} is not reachable ({e.reason if hasattr(e, 'reason') else e})"}


def registry() -> list[dict]:
    with open(REGISTRY, encoding="utf-8") as f:
        return json.load(f).get("projects", [])


def registry_groups() -> list[str]:
    with open(REGISTRY, encoding="utf-8") as f:
        return [g for g in json.load(f).get("groups", []) if isinstance(g, str)]


def project(name: str) -> dict:
    for p in registry():
        if p.get("name") == name:
            return p
    return {}


def controllable(p: dict) -> bool:
    svc = p.get("service") or {}
    return bool(svc.get("start") and svc.get("stop"))


def machine_line() -> str:
    try:
        with open(os.path.join(WWW, "status.json"), encoding="utf-8") as f:
            s = json.load(f)
    except (OSError, ValueError):
        return ""
    cpu, mem, disk = s.get("cpu") or {}, s.get("mem") or {}, s.get("disk") or {}
    parts = []
    if cpu.get("load"):
        parts.append(f"load {cpu['load'][0]:.2f}")
    if cpu.get("temp_c") is not None:
        parts.append(f"{cpu['temp_c']} °C")
    if mem.get("total"):
        parts.append(f"mem {round(100 * mem.get('used', 0) / mem['total'])} %")
    if disk.get("pct") is not None:
        parts.append(f"disk {disk['pct']} %")
    up = s.get("uptime_s")
    if up:
        parts.append(f"up {int(up // 86400)}d {int(up % 86400 // 3600)}h")
    return "  ·  ".join(parts)


# --- default project per chat -------------------------------------------------

def load_defaults() -> None:
    global _defaults
    try:
        with open(DEFAULTS_FILE, encoding="utf-8") as f:
            _defaults = {str(k): str(v) for k, v in json.load(f).items()}
    except (OSError, ValueError):
        _defaults = {}


def set_default(chat: int, name: str) -> None:
    with _lock:
        _defaults[str(chat)] = name
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(DEFAULTS_FILE, "w", encoding="utf-8") as f:
                json.dump(_defaults, f, indent=1)
        except OSError as e:
            log(f"defaults: could not save: {e}")


def pick_project(chat: int, args: list[str], need_rest: bool) -> tuple[dict, list[str], str]:
    """(project, remaining args, error). The first word is the project if it
    is a registered name; otherwise the chat's default project is used and
    all words stay as arguments. need_rest: the command takes free text after
    the name, so an unknown first word may be the start of that text."""
    if args and project(args[0]):
        return project(args[0]), args[1:], ""
    d = _defaults.get(str(chat))
    if d and project(d):
        return project(d), args, ""
    if args and not need_rest:
        return {}, args, f"'{args[0]}' is not a registered project (/projects lists them)"
    return {}, args, "which project? give its name first or switch to one with /project <project>"


# --- commands -----------------------------------------------------------------

HELP = """fractal bot

Plain text is a chat with Claude on this machine - in general (in $HOME) or
in the context of one project. Each context remembers its conversation.
/chat – general chat · /project <p> – chat in project p
/projects – folders; /projects <folder> – the projects in one, tap to switch
/new – start the current conversation over

/status – what is up, what is down
/start <p> · /stop <p> – toggle a project's stack
/run <p> [hook] – run a named action (no hook: list them)
/send <p> <text> – paste text into the project's live agent window (no answer here)
/ask <p> <question> – one-off headless question, answer comes back here
/task <p> <text> – new task on the board; "task …" or "úkol …" without the slash works too
/tasks [p] – what the board is waiting on you for
<p> may be left out after /project

Dashboard: {url}"""


HELP_WORDS = ("help", "napoveda", "nápověda", "pomoc")   # a bare word, for dictation


def help_topics() -> tuple[str, list[tuple[str, str, str]]]:
    """(overview, [(key, button label, text)]). The help file may be split
    into topics by lines "## <key> | <button label>"; what comes before the
    first one is the overview /help shows, with a button per topic."""
    try:
        with open(HELP_FILE, encoding="utf-8") as f:
            raw = f.read()
    except OSError:
        raw = HELP
    raw = raw.replace("{url}", URL)
    parts = re.split(r"^## +(\S+) *\| *(.+?) *$", raw, flags=re.M)
    topics = [(parts[i].lower(), parts[i + 1], parts[i + 2].strip()) for i in range(1, len(parts) - 2, 3)]
    return parts[0].strip(), topics


def help_view(chat: int, key: str = "") -> tuple[str, list]:
    overview, topics = help_topics()
    where = f"📍 {ctx_line(chat)}"
    for k, label, text in topics:
        if key and fold(key) in (fold(k), fold(label)):
            return f"{label}\n\n{text}", [[("« help", "h:")]]
    btns = [(label, f"h:{k}") for k, label, _ in topics]
    rows = [btns[i:i + 2] for i in range(0, len(btns), 2)]
    return f"{overview}\n\n{where}", rows


def cmd_help(chat: int, args: list[str]) -> None:
    text, rows = help_view(chat, " ".join(args))
    say(chat, text, buttons=rows or None)


def cmd_status(chat: int, _args: list[str]) -> None:
    code, data = ctl("GET", "/state")
    if code != 200:
        return say(chat, "✗ " + data.get("error", "no state"))
    states = data.get("projects") or {}
    titles = {p["name"]: p.get("title") or p["name"] for p in registry()}
    lines = []
    for name in sorted(states, key=lambda n: (not states[n]["up"], n)):
        s = states[name]
        if s.get("busy"):
            mark, word = "◐", s["busy"] + "…"
        elif s["up"]:
            mark, word = "●", "up"
        else:
            mark, word = "○", "down"
        last = s.get("last") or {}
        note = f"   ⚠ {last['action']} failed" if last and last.get("ok") is False else ""
        lines.append(f"{mark} {name:<14} {word}{note}")
    if not lines:
        lines.append("no controllable projects (none has service.start/stop)")
    m = machine_line()
    text = "\n".join(lines) + (f"\n\n{m}" if m else "")
    say(chat, text, mono=True)


# --- folders and the project picker -------------------------------------------
# A folder is a registry group (the dashboard's sections). Each usually lives
# in one directory under ~/projects, so "/projects ac" finds "Acme
# Clients" as well as "/projects acm" does.

PROJECTS_DIR = os.path.join(os.path.expanduser("~"), "projects")


def fold(t: str) -> str:
    """lowercase, no diacritics, no spaces: "Home Lab" -> "homelab" """
    import unicodedata
    t = unicodedata.normalize("NFKD", t.lower())
    return "".join(c for c in t if c.isalnum())


def folders() -> list[dict]:
    """[{"name", "dir", "projects"}] in dashboard order."""
    by: dict[str, list[dict]] = {}
    for p in registry():
        by.setdefault(p.get("group") or "other", []).append(p)
    order = [g for g in registry_groups() if g in by] + sorted(g for g in by if g not in registry_groups())
    out = []
    for g in order:
        dirs: dict[str, int] = {}
        for p in by[g]:
            rel = os.path.relpath(os.path.expanduser(p.get("root") or "~"), PROJECTS_DIR)
            if not rel.startswith(".."):
                d = rel.split(os.sep)[0]
                dirs[d] = dirs.get(d, 0) + 1
        out.append({"name": g, "dir": max(dirs, key=dirs.get) if dirs else "",
                    "projects": sorted(by[g], key=lambda p: p["name"])})
    return out


def find_folder(q: str) -> tuple[int, dict] | tuple[None, None]:
    """By group name or directory: exact first, then prefix, then substring."""
    q = fold(q)
    fs = folders()
    for test in (lambda k: k == q, lambda k: k.startswith(q), lambda k: q in k):
        for i, f in enumerate(fs):
            if any(test(k) for k in (fold(f["name"]), fold(f["dir"])) if k):
                return i, f
    return None, None


def caps(p: dict) -> str:
    c = []
    if controllable(p):
        c.append("start/stop")
    if p.get("hooks"):
        c.append("run: " + " ".join(sorted(p["hooks"])))
    return ", ".join(c)


def ctx_line(chat: int) -> str:
    c = chat_ctx(chat)
    return f"now: chatting in {c}" if c else "now: general chat"


def folders_view(chat: int) -> tuple[str, list]:
    fs = folders()
    lines = [f"📁 {f['name']}" + (f"  ~/projects/{f['dir']}" if f["dir"] else "") + f"  · {len(f['projects'])}"
             for f in fs]
    text = ("Folders - tap one, or /projects <folder>\n\n" + "\n".join(lines)
            + f"\n\n{ctx_line(chat)}")
    btns = [(f"{f['name']} ({len(f['projects'])})", f"f:{i}") for i, f in enumerate(fs)]
    rows = [btns[i:i + 2] for i in range(0, len(btns), 2)] + [[("💬 general chat", "c:")]]
    return text, rows


def folder_view(chat: int, i: int, f: dict) -> tuple[str, list]:
    cur = chat_ctx(chat)
    lines = []
    for p in f["projects"]:
        title = p.get("title") if p.get("title") and p.get("title") != p["name"] else ""
        extra = " · ".join(x for x in (title, caps(p)) if x)
        lines.append(("▶ " if p["name"] == cur else "• ") + p["name"] + (f" – {extra}" if extra else ""))
    where = f"  ~/projects/{f['dir']}" if f["dir"] else ""
    text = (f"📁 {f['name']}{where}\n\n" + "\n".join(lines)
            + f"\n\ntap a project to chat in its context · {ctx_line(chat)}")
    btns = [(p["name"], f"p:{p['name']}") for p in f["projects"]]
    rows = [btns[k:k + 3] for k in range(0, len(btns), 3)] + [[("« folders", "F"), ("💬 general chat", "c:")]]
    return text, rows


def cmd_projects(chat: int, args: list[str]) -> None:
    if not args:
        text, rows = folders_view(chat)
        return say(chat, text, buttons=rows)
    i, f = find_folder(" ".join(args))
    if f is None:
        if project(args[0]):
            return say(chat, f"{args[0]} is a project, not a folder - /project {args[0]} switches to it")
        text, rows = folders_view(chat)
        return say(chat, f"no folder matches '{' '.join(args)}'\n\n" + text, buttons=rows)
    text, rows = folder_view(chat, i, f)
    say(chat, text, buttons=rows)


def cmd_project(chat: int, args: list[str]) -> None:
    if not args:
        text, rows = folders_view(chat)
        return say(chat, text, buttons=rows)
    if not project(args[0]):
        i, f = find_folder(" ".join(args))
        if f is not None:                          # "/project shop" when shop were only a folder
            text, rows = folder_view(chat, i, f)
            return say(chat, text, buttons=rows)
        return say(chat, f"'{args[0]}' is not a registered project - /projects lists them")
    say(chat, switch_ctx(chat, args[0]))


def cmd_toggle(chat: int, args: list[str], action: str) -> None:
    p, _rest, err = pick_project(chat, args, need_rest=False)
    if err:
        return say(chat, err)
    name = p["name"]
    if not controllable(p):
        return say(chat, f"{name} has no start/stop command in the registry")
    code, data = ctl("POST", f"/{name}/{action}")
    if code == 409:
        return say(chat, f"{name}: {data.get('error')}")
    if code != 202:
        return say(chat, f"✗ {name}: {data.get('error', code)}")
    mid = say(chat, f"◐ {name}: {action}…")
    deadline = time.monotonic() + TOGGLE_WAIT
    while time.monotonic() < deadline:
        time.sleep(1.5)
        code, data = ctl("GET", "/state")
        s = (data.get("projects") or {}).get(name) if code == 200 else None
        if s and not s.get("busy"):
            last = s.get("last") or {}
            if last.get("ok"):
                return edit(chat, mid, f"{'●' if s['up'] else '○'} {name} is {'up' if s['up'] else 'down'}")
            return edit(chat, mid, f"✗ {name}: {action} failed\n{last.get('msg', '')}".strip())
    edit(chat, mid, f"? {name}: still busy after {TOGGLE_WAIT} s, check /status later")


def cmd_run(chat: int, args: list[str]) -> None:
    p, rest, err = pick_project(chat, args, need_rest=False)
    if err:
        return say(chat, err)
    name, hooks = p["name"], p.get("hooks") or {}
    if not hooks:
        return say(chat, f"{name} has no hooks")
    if not rest:
        return say(chat, f"{name} hooks: " + ", ".join(sorted(hooks)) + f"\n/run {name} <hook>")
    hook = rest[0]
    if hook not in hooks:
        return say(chat, f"{name} has no hook '{hook}' (has: {', '.join(sorted(hooks))})")
    code, data = ctl("POST", f"/run/{name}/{hook}")
    if code == 409:
        return say(chat, f"{name}/{hook}: already running")
    if code != 202:
        return say(chat, f"✗ {name}/{hook}: {data.get('error', code)}")
    mid = say(chat, f"◐ {name}/{hook} running…")
    deadline = time.monotonic() + HOOK_WAIT
    while time.monotonic() < deadline:
        time.sleep(2)
        code, data = ctl("GET", f"/run/{name}/{hook}")
        if code == 200 and not data.get("running"):
            if data.get("ok"):
                return edit(chat, mid, f"✓ {name}/{hook} done in {data.get('took', 0)} s")
            return edit(chat, mid, f"✗ {name}/{hook} failed after {data.get('took', 0)} s\n{data.get('msg', '')}".strip())
    edit(chat, mid, f"? {name}/{hook}: still running after {HOOK_WAIT // 60} min")


def cmd_send(chat: int, args: list[str]) -> None:
    p, rest, err = pick_project(chat, args, need_rest=True)
    if err:
        return say(chat, err)
    text = "\n".join(rest).strip() if len(rest) == 1 else " ".join(rest).strip()
    if not text:
        return say(chat, f"/send {p['name']} <text>")
    if p.get("terminal") is False:
        return say(chat, f"{p['name']} has no agent window")
    # blocks up to ~50 s when the tmux session has to be started first
    code, data = ctl("POST", f"/agent/{p['name']}/send", {"text": text}, timeout=90)
    if code == 200:
        return say(chat, f"→ pasted into {p['name']} ({URL}term/?arg={p['name']})")
    say(chat, f"✗ {p['name']}: {data.get('error', code)}")


def cmd_ask(chat: int, args: list[str]) -> None:
    p, rest, err = pick_project(chat, args, need_rest=True)
    if err:
        return say(chat, err)
    q = " ".join(rest).strip()
    if not q:
        return say(chat, f"/ask {p['name']} <question>")
    name = p["name"]
    code, data = ctl("POST", f"/agent/{name}/query", {"q": q})
    if code != 202:
        return say(chat, f"✗ {name}: {data.get('error', code)}")
    stream_answer(chat, f"/agent/{name}/query/{data['id']}", name)


def stream_answer(chat: int, poll: str, label: str) -> dict:
    """Show a fractal-ctl job in one message that is edited while the answer
    grows; long final answers continue in more messages. Returns the done job
    ({} when it did not finish)."""
    mid = say(chat, f"◐ {label} is thinking…")
    shown, last_edit = "", time.monotonic()
    deadline = time.monotonic() + QUERY_WAIT
    while time.monotonic() < deadline:
        time.sleep(1)
        code, j = ctl("GET", poll)
        if code != 200:
            edit(chat, mid, f"✗ {label}: {j.get('error', code)}")
            return {}
        answer = (j.get("answer") or "").strip()
        if j.get("done"):
            final = answer or "(no answer)"
            if not j.get("ok"):
                final = "✗ " + final
            parts = chunks(final)
            edit(chat, mid, parts[0])
            for extra in parts[1:]:
                say(chat, extra)
            return j
        # stream: edit the one message while the text grows, but not on every poll
        if answer and answer != shown and time.monotonic() - last_edit >= EDIT_EVERY:
            edit(chat, mid, answer[-TG_MAX:] + " ▍")
            shown, last_edit = answer, time.monotonic()
    edit(chat, mid, f"✗ {label}: no answer within {QUERY_WAIT // 60} min")
    return {}


# --- chat: plain text is a conversation with the agent -----------------------
# Every chat has a context: "" = general (claude in $HOME) or a project name
# (claude in the project root). Each context keeps its own conversation, so
# switching back to a project continues where it was left.

def load_chats() -> None:
    global _chats
    try:
        with open(CHATS_FILE, encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, ValueError):
        raw = {}
    _chats = {}
    for k, v in (raw.items() if isinstance(raw, dict) else []):
        v = dict(v) if isinstance(v, dict) else {}
        sessions = dict(v.get("sessions") or {})
        if v.get("session") and "" not in sessions:        # the first format: one session
            sessions[""] = v["session"]
        _chats[str(k)] = {"ctx": str(v.get("ctx") or ""), "sessions": sessions}


def save_chats() -> None:
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(CHATS_FILE, "w", encoding="utf-8") as f:
            json.dump(_chats, f, indent=1)
    except OSError as e:
        log(f"chats: could not save: {e}")


def chat_state(chat: int) -> dict:
    return _chats.setdefault(str(chat), {"ctx": "", "sessions": {}})


def chat_ctx(chat: int) -> str:
    c = _chats.get(str(chat), {}).get("ctx") or ""
    return c if not c or project(c) else ""      # a project that left the registry


def set_session(chat: int, ctx: str, sid: str) -> None:
    with _lock:
        chat_state(chat)["sessions"][ctx] = sid
        save_chats()


def switch_ctx(chat: int, name: str) -> str:
    """Make `name` ("" = general) the chat's context; a project also becomes
    the default project of /ask, /send, /run and /task."""
    with _lock:
        st = chat_state(chat)
        st["ctx"] = name
        save_chats()
        has = bool(st["sessions"].get(name))
    cont = "continuing the last conversation" if has else "new conversation"
    if not name:
        return f"💬 general chat ({cont}) - just write. /projects picks a project, /new starts over"
    set_default(chat, name)
    p = project(name)
    root = (p.get("root") or "~").replace(os.path.expanduser("~"), "~", 1)
    return (f"📂 {name} ({cont}) - Claude works in {root}. Just write; "
            f"/new starts over, /chat goes back to the general chat")


def cmd_chat(chat: int, args: list[str]) -> None:
    if chat_ctx(chat) or not args:
        say(chat, switch_ctx(chat, ""))
    if args:                                   # "/chat what is the weather" = general + first message
        chat_turn(chat, " ".join(args))


def cmd_new(chat: int, args: list[str]) -> None:
    ctx = chat_ctx(chat)
    set_session(chat, ctx, "")
    if args:
        return chat_turn(chat, " ".join(args))
    say(chat, f"💬 new conversation{' in ' + ctx if ctx else ''} - just write")


def chat_turn(chat: int, text: str) -> None:
    """One message of the conversation. Turns run one after another: a
    message written while Claude still answers waits for that answer, so it
    resumes the conversation that already contains it."""
    with _lock:
        turn = _chat_turn.setdefault(str(chat), threading.Lock())
    if not turn.acquire(blocking=False):
        say(chat, "⏳ queued after the current answer")
        turn.acquire()
    try:
        ctx = chat_ctx(chat)
        session = chat_state(chat)["sessions"].get(ctx) or ""
        code, data = ctl("POST", "/chat", {"q": text, "session": session, "project": ctx})
        if code != 202:
            return say(chat, f"✗ chat: {data.get('error', code)}")
        j = stream_answer(chat, f"/chat/{data['id']}", f"Claude · {ctx}" if ctx else "Claude")
        if j.get("session"):
            set_session(chat, ctx, j["session"])
    finally:
        turn.release()


def handle_button(cq: dict) -> None:
    """A tap on a picker button: the message turns into the next view."""
    user = (cq.get("from") or {}).get("id")
    msg = cq.get("message") or {}
    chat, mid, data = (msg.get("chat") or {}).get("id"), msg.get("message_id"), cq.get("data") or ""
    if user not in USERS or chat is None:
        return
    note = ""
    try:
        if data.startswith("h:"):
            text, rows = help_view(chat, data[2:])
            edit(chat, mid, text, rows or None)
        elif data == "F":
            text, rows = folders_view(chat)
            edit(chat, mid, text, rows)
        elif data.startswith("f:") and data[2:].isdigit():
            fs = folders()
            i = int(data[2:])
            if i < len(fs):
                text, rows = folder_view(chat, i, fs[i])
                edit(chat, mid, text, rows)
        elif data.startswith("p:") and project(data[2:]):
            note = "→ " + data[2:]
            edit(chat, mid, switch_ctx(chat, data[2:]))
        elif data == "c:":
            note = "→ general chat"
            edit(chat, mid, switch_ctx(chat, ""))
    except Exception as e:                                    # noqa: BLE001
        log(f"button {data} failed: {type(e).__name__}: {e}")
        note = "✗ " + str(e)[:150]
    try:
        tg("answerCallbackQuery", callback_query_id=cq["id"], text=note)
    except Exception as e:                                    # noqa: BLE001
        log(f"answerCallbackQuery: {e}")


TASK_WORDS = ("task", "ukol", "úkol")
WAITING = {"review": "to review", "need-attention": "needs you"}


def cmd_task(chat: int, args: list[str]) -> None:
    p, rest, err = pick_project(chat, args, need_rest=True)
    if err:
        return say(chat, err)
    text = " ".join(rest).strip()
    if not text:
        return cmd_tasks(chat, [p["name"]])
    name = p["name"]
    code, data = tasks_api("POST", f"/{name}/tasks", {"title": text[:120], "request": text})
    if code != 201:
        return say(chat, f"✗ {name}: {data.get('error', code)}")
    state = "triage started" if data.get("status") == "triage" else data.get("status", "")
    say(chat, f"☑ {name} · task {data['id']} created ({state})\n{URL}tasks.html#{name}/{data['id']}")


def cmd_tasks(chat: int, args: list[str]) -> None:
    p, _rest, err = pick_project(chat, args, need_rest=False)
    if err:
        return say(chat, err)
    name = p["name"]
    code, data = tasks_api("GET", f"/{name}/tasks")
    if code != 200:
        return say(chat, f"✗ {name}: {data.get('error', code)}")
    tasks = data.get("tasks") or []
    lines = []
    for t in tasks:
        if t["status"] in WAITING:
            kind = "plan" if t.get("phase") == "triage" else "work"
            lines.append(f"⚠ {t['id']} {t['title']} – {kind} {WAITING[t['status']]}")
    for t in tasks:
        if t["status"] in ("triage", "in-progress"):
            lines.append(f"◐ {t['id']} {t['title']} – {t['status']}")
    queued = [t for t in tasks if t["status"] == "todo"]
    if queued:
        lines.append(f"○ queue: " + ", ".join(f"{t['id']} {t['title']}" for t in queued[:6])
                     + (" …" if len(queued) > 6 else ""))
    if not lines:
        lines.append("nothing waiting, nothing running")
    say(chat, f"{name} board\n" + "\n".join(lines) + f"\n{URL}tasks.html#{name}")


COMMANDS = {
    "help": cmd_help,
    "status": cmd_status, "s": cmd_status,
    "projects": cmd_projects, "list": cmd_projects,
    "use": cmd_project,                        # the older name of /project
    "start": lambda c, a: cmd_toggle(c, a, "start"),
    "stop": lambda c, a: cmd_toggle(c, a, "stop"),
    "run": cmd_run,
    "send": cmd_send,
    "ask": cmd_ask,
    "task": cmd_task, "ukol": cmd_task,
    "tasks": cmd_tasks, "ukoly": cmd_tasks,
    "chat": cmd_chat,
    "new": cmd_new,
    "project": cmd_project, "p": cmd_project,
    "folders": cmd_projects, "slozky": cmd_projects,
}

MENU = [
    ("help", "what the bot can do, by topic"),
    ("chat", "general chat with Claude (not in a project)"),
    ("project", "chat in a project's context: /project <p>"),
    ("projects", "folders and their projects: /projects [folder]"),
    ("new", "start a fresh conversation"),
    ("status", "what is up and what is down"),
    ("start", "start a project: /start <p>"),
    ("stop", "stop a project: /stop <p>"),
    ("run", "run a named action: /run <p> [hook]"),
    ("send", "paste text into the agent window"),
    ("ask", "headless question to the agent"),
    ("task", "new task on the board: /task <p> <text>"),
    ("tasks", "what the board is waiting on you for"),
]


def handle(msg: dict) -> None:
    chat = msg["chat"]["id"]
    user = (msg.get("from") or {}).get("id")
    text = (msg.get("text") or "").strip()
    if msg["chat"].get("type") != "private" or user is None:
        return                                                # groups are not supported
    if not USERS:
        # bootstrap: tell the sender their ID so it can be put into the config
        say(chat, f"fractal bot is not configured yet.\n\nYour Telegram user ID is {user}.\n"
                  f"Put it into FRACTAL_TELEGRAM_USERS in fractal.env and run ./install.sh.")
        log(f"unconfigured: message from user {user}")
        return
    if user not in USERS:
        if user not in _seen_strangers:
            _seen_strangers.add(user)
            log(f"ignored message from user {user} (not in FRACTAL_TELEGRAM_USERS)")
        return
    if not text.startswith("/"):
        # dictation has no slashes: "úkol <text>" / "task <text>" is a new task
        head, _, rest = text.partition(" ")
        if head.lower().strip(",.:;") in TASK_WORDS and rest.strip():
            return cmd_task(chat, rest.split())
        if text.lower().strip(" ,.!?") in HELP_WORDS:
            return cmd_help(chat, [])
        # everything else is the conversation, in the chat's context; the
        # first word is deliberately NOT parsed as a project name - a thought
        # that starts with "shop ..." must not switch anything
        return chat_turn(chat, text)
    words = text.split()
    cmd = words[0][1:].split("@")[0].lower()       # "/ask@my_bot" in some clients
    fn = COMMANDS.get(cmd)
    if fn is None:
        return say(chat, f"unknown command /{cmd} — /help")
    if cmd == "start" and len(words) == 1:
        return cmd_help(chat, [])                  # Telegram sends a bare /start on first open
    try:
        fn(chat, words[1:])
    except Exception as e:                                    # noqa: BLE001
        log(f"/{cmd} failed: {type(e).__name__}: {e}")
        try:
            say(chat, f"✗ {type(e).__name__}: {e}")
        except Exception:                                     # noqa: BLE001
            pass


# --- watcher: tell about projects that die or come back ---------------------

def watch() -> None:
    prev: dict[str, bool] = {}
    while True:
        try:
            code, data = ctl("GET", "/state")
            if code == 200:
                cur = {n: s["up"] for n, s in (data.get("projects") or {}).items() if not s.get("busy")}
                for name, up in cur.items():
                    if name in prev and prev[name] != up:
                        text = f"{'● ' + name + ' is up again' if up else '○ ' + name + ' went down'}"
                        log("watch: " + text)
                        for uid in USERS:
                            try:
                                say(uid, text)
                            except Exception as e:            # noqa: BLE001
                                log(f"watch: could not notify {uid}: {e}")
                # a project that vanished from the registry is simply forgotten
                prev = {**{k: v for k, v in prev.items() if k in cur}, **cur}
        except Exception as e:                                # noqa: BLE001
            log(f"watch: {type(e).__name__}: {e}")
        time.sleep(WATCH)


# --- main loop ----------------------------------------------------------------

def read_token() -> str:
    t = os.environ.get("FRACTAL_TELEGRAM_TOKEN", "").strip()
    if t:
        return t
    try:
        st = os.stat(TOKEN_FILE)
        if st.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
            log(f"warning: {TOKEN_FILE} is readable by others; chmod 600 it")
        with open(TOKEN_FILE, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def configure(token: str) -> None:
    if not re.fullmatch(r"\d+:[A-Za-z0-9_-]{30,}", token):
        sys.exit("that does not look like a bot token (expected <digits>:<letters>, from @BotFather)")
    os.makedirs(os.path.dirname(TOKEN_FILE), exist_ok=True)
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(token + "\n")
    os.chmod(TOKEN_FILE, 0o600)
    print(f"token written to {TOKEN_FILE}")
    print("next: ./install.sh  (enables fractal-telegram.service), then message the bot;")
    print("      it answers with your user ID until FRACTAL_TELEGRAM_USERS is set.")


def main() -> None:
    global _token
    if len(sys.argv) >= 2 and sys.argv[1] == "configure":
        if len(sys.argv) != 3:
            sys.exit("usage: fractal-telegram configure <bot token>")
        return configure(sys.argv[2])
    if len(sys.argv) >= 2 and sys.argv[1] == "notify":
        _token = read_token()
        text = " ".join(sys.argv[2:]).strip()
        if not _token or not text or not USERS:
            sys.exit("notify: needs a token, a text and FRACTAL_TELEGRAM_USERS")
        for uid in USERS:
            try:
                say(uid, text)
            except Exception as e:                            # noqa: BLE001
                log(f"notify: could not reach {uid}: {e}")
        return
    if len(sys.argv) >= 2:
        sys.exit(__doc__)
    _token = read_token()
    if not _token:
        sys.exit(f"no bot token: run `fractal-telegram configure <token>` (writes {TOKEN_FILE})")
    load_defaults()
    load_chats()

    me = None
    while me is None:
        try:
            me = tg("getMe")
        except Exception as e:                                # noqa: BLE001
            log(f"getMe failed ({type(e).__name__}: {e}); retrying in 15 s")
            time.sleep(15)
    log(f"bot @{me.get('username')} running; allowed users: {sorted(USERS) or 'NONE (bootstrap mode)'}")
    try:
        tg("setMyCommands", commands=[{"command": c, "description": d} for c, d in MENU])
    except Exception as e:                                    # noqa: BLE001
        log(f"setMyCommands: {e}")

    # Drop whatever queued up while the bot was down: replaying an hour-old
    # "/stop shop" after a restart is exactly what nobody wants.
    offset = 0
    try:
        stale = tg("getUpdates", offset=-1, timeout=0)
        if stale:
            offset = stale[-1]["update_id"] + 1
    except Exception as e:                                    # noqa: BLE001
        log(f"getUpdates (drain): {e}")

    if WATCH > 0 and USERS:
        threading.Thread(target=watch, daemon=True).start()

    while True:
        try:
            updates = tg("getUpdates", http_timeout=POLL_TIMEOUT + 10, offset=offset,
                         limit=20, allowed_updates=["message", "callback_query"], timeout=POLL_TIMEOUT)
        except Exception as e:                                # noqa: BLE001
            log(f"getUpdates: {type(e).__name__}: {e}; retrying in 5 s")
            time.sleep(5)
            continue
        for u in updates:
            offset = max(offset, u["update_id"] + 1)
            msg = u.get("message")
            if msg:
                # each command in its own thread: a 5-minute /ask must not block /status
                threading.Thread(target=handle, args=(msg,), daemon=True).start()
            if u.get("callback_query"):
                threading.Thread(target=handle_button, args=(u["callback_query"],), daemon=True).start()


if __name__ == "__main__":
    main()
