#!/usr/bin/env python3
"""Control backend for the dashboard: start/stop projects, talk to their agent.

Runs as the normal user on the loopback interface; nginx exposes it under
/ctl/ and restricts that location to the tailnet. It is not plain nginx
because commands (docker compose, dev servers) get executed here, and
www-data must not be able to do that.

SECURITY: the client NEVER sends a command. It sends a project name and a
verb (start/stop, a hook name, free text for the agent). The command itself
comes from the registry (projects.json, field "service" or "hooks"); a
project without those fields cannot be controlled at all. Commands run
without a shell (shlex + execvp), so nothing can be chained onto them. Text
for the agent is pasted into tmux via load-buffer/paste-buffer (literal, no
key interpretation) or passed to `claude -p` on stdin - never interpolated
into a command line.

State is not obtained by running "<ctl> status" (slow for docker projects).
A TCP connect to the "probe" port is tried instead: the port the application
itself listens on. Proxy ports (nginx) would report "up" while the app is
long gone.

Every toggle is remembered (fractal-autostart set) so that after a reboot only
what was running comes back. It is written when the request is accepted, not
when it finishes - a power cut in the middle of a start must not lose what
the user asked for.

Endpoints (all relative to /ctl/):
    GET  /state                          up/busy/last per controllable project,
                                         plus "terms": extra terminal sessions <project>-p<n>/-s<n>
    POST /<project>/start|stop           run the registry command
    POST /<project>/term/p|s             create the next free extra terminal; returns {win}
    POST /<project>/term/<window>/close  kill an extra terminal session (p<n> or s<n> only)
    GET  /term-title?arg=<terminal>      tab name of a browser terminal and the prefix the
                                         tab shows before it (404 = not ours, 409 = ours
                                         but not running)
    POST /term-title {arg, title}        set it; an empty title removes it
    POST /agent/<project>/send  {text}   paste text into the project's agent window
    POST /agent/<project>/query {q}      headless question; returns {id}
    GET  /agent/<project>/query/<id>     poll the streamed answer
    POST /chat {q, session, project}     free conversation with the agent - in $HOME, or in
                                         the project's root with its claudeArgs when project
                                         is given; session = id from a previous answer
                                         continues that conversation; returns {id}
    GET  /chat/<id>                      poll it like a query; done answers carry "session"
    POST /run/<project>/<hook>           run a named hook from the registry
    GET  /run/<project>/<hook>           status of the last/current run
    GET  /sessions                       live Claude Code sessions (fractal_sessions)
    POST /sessions/<session id>/summary  one-sentence summary by a small model
"""
import json
import os
import re
import shlex
import socket
import subprocess
import sys
import threading
import time
import urllib.parse
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from fractal_config import CFG, HOME, REGISTRY, agent_cmd, bin_path_env, port  # noqa: E402
import fractal_sessions  # noqa: E402

PORT = port("CTL")
PROBE_TIMEOUT = 0.4          # a local port answers at once, or it is down
ACTION_TIMEOUT = 300         # docker compose up can be lazy, but not forever
QUERY_TIMEOUT = 600
# a chat is read on a phone (Telegram): the client cannot render Markdown
CHAT_PROMPT = ("The user is chatting with you from their phone through a Telegram bot. "
               "Telegram shows your reply as plain text: no Markdown tables, headings or "
               "bold, use short paragraphs and simple dashes for lists. Be concise unless "
               "asked for detail. You are on the user's server and can use your tools "
               "when the conversation needs it.")
HOOK_TIMEOUT = 1800
MAX_TEXT = 100_000
AGENT_WINDOW = CFG["FRACTAL_AGENT_WINDOW"]

ENV = bin_path_env()

# in flight: name -> {"action": "start"|"stop", "since": float}
# last result: name -> {"ok": bool, "msg": str, "at": float}
_busy: dict[str, dict] = {}
_last: dict[str, dict] = {}
_qjobs: dict[str, dict] = {}          # id -> {"done", "ok", "answer", "at"[, "session"]}
_hooks: dict[str, dict] = {}          # "name/hook" -> {"running", "ok", "msg", "at", "took"}
_lock = threading.Lock()


def registry() -> dict:
    """Read on every request - registry edits apply without a restart."""
    with open(REGISTRY, encoding="utf-8") as f:
        return json.load(f)


def project(name: str) -> dict:
    for p in registry().get("projects", []):
        if p.get("name") == name:
            return p
    return {}


def services() -> dict:
    """Projects that can be toggled: "service" with both start and stop."""
    out = {}
    for p in registry().get("projects", []):
        svc = p.get("service") or {}
        if svc.get("start") and svc.get("stop"):
            out[p["name"]] = {"start": svc["start"], "stop": svc["stop"], "probe": svc.get("probe")}
    return out


def remember(name: str, action: str) -> None:
    """Tell the autostart memory whether the project should be up after a reboot.

    The file format is known only to fractal-autostart so it lives in one
    place. If this fails the action still runs - the switch must not stop
    working because the bookkeeping did.
    """
    try:
        r = subprocess.run(["fractal-autostart", "set", name, "on" if action == "start" else "off"],
                           capture_output=True, text=True, timeout=15, env=ENV)
        if r.returncode:
            print(f"autostart: could not remember {name}: {r.stderr.strip()}", flush=True)
    except Exception as e:                                    # noqa: BLE001
        print(f"autostart: could not remember {name}: {type(e).__name__}: {e}", flush=True)


def port_open(p) -> bool:
    if not p:
        return False
    try:
        with socket.create_connection(("127.0.0.1", int(p)), PROBE_TIMEOUT):
            return True
    except OSError:
        return False


def snapshot() -> dict:
    out = {}
    with _lock:
        busy, last = dict(_busy), dict(_last)
    for name, svc in services().items():
        b = busy.get(name)
        out[name] = {"up": port_open(svc["probe"]), "busy": b["action"] if b else None,
                     "last": last.get(name)}
    return out


# Extra terminals of a project, opened from the dashboard as
# /term/?arg=<project>:<window>: p<n> = a new agent conversation, s<n> = a
# shell, each in a tmux session of its own named <project>-<window>.
TERM_WIN = re.compile(r"^[ps][1-9][0-9]?$")
TERM_SESSION = re.compile(r"^(.+)-([ps][1-9][0-9]?)$")


def term_owner(session: str, names: set) -> tuple[str, str] | None:
    """(project, window) when the session is an extra terminal. A registered
    project of the same name owns the session - shop-p1 the project wins over
    shop-p1 the extra terminal of shop."""
    m = TERM_SESSION.match(session)
    if not m or session in names or m.group(1) not in names:
        return None
    return m.group(1), m.group(2)


def term_windows() -> dict:
    """{project: [{"win", "pane", "title"}]} for every extra terminal session;
    pane is its active pane, which the dashboard pairs with the Claude session
    list, title the tab name given in the terminal ("" when none)."""
    try:
        r = subprocess.run(["tmux", "list-sessions", "-F",
                            "#{session_name}\t#{pane_id}\t#{" + TITLE_OPT + "}"],
                           capture_output=True, text=True, timeout=5, env=ENV)
    except (OSError, subprocess.TimeoutExpired):
        return {}
    names = {p.get("name") for p in registry().get("projects", [])}
    out = {}
    for line in r.stdout.splitlines():
        sess, pane, title = (line.split("\t") + ["", ""])[:3]
        own = term_owner(sess, names)
        if own:
            out.setdefault(own[0], []).append({"win": own[1], "pane": pane.lstrip("%"), "title": title})
    for ws in out.values():
        ws.sort(key=lambda w: (w["win"][0], int(w["win"][1:])))
    return out


def close_term(name: str, win: str) -> bool:
    """Kill one extra terminal session. Only <project>-p<n>/-s<n> of a
    registered project - never the project's own session or another project's."""
    names = {p.get("name") for p in registry().get("projects", [])}
    if name not in names or not TERM_WIN.match(win):
        return False
    sess = f"{name}-{win}"
    if term_owner(sess, names) is None:
        return False
    r = subprocess.run(["tmux", "kill-session", "-t", "=" + sess],
                       capture_output=True, timeout=5, env=ENV)
    return r.returncode == 0


_term_lock = threading.Lock()


def new_term(name: str, kind: str) -> str | None:
    """Create the next free extra terminal <project>-<kind><n> and return its
    window (p3). The number is picked here, under a lock, from what tmux runs
    right now - a dashboard with a stale list must never land in an existing
    session and pass its conversation and tab name off as a new one."""
    names = {p.get("name") for p in registry().get("projects", [])}
    if name not in names or kind not in ("p", "s"):
        return None
    with _term_lock:
        used = {w["win"] for w in term_windows().get(name, [])}
        for n in range(1, 100):
            win = f"{kind}{n}"
            if win in used or f"{name}-{win}" in names:
                continue
            if _tmux("has-session", "-t", f"={name}-{win}").returncode == 0:
                continue                  # e.g. a session that is not ours by name
            r = subprocess.run(["work", "-d", name, win], capture_output=True,
                               text=True, timeout=15, env=ENV)
            return win if r.returncode == 0 else None
    return None


# Name of a browser terminal tab, set from the terminal page (the pencil icon
# from termkeys.js). It lives in tmux as a user option, so every device shows
# the same name and it disappears together with the terminal. The page only
# sends its own address (?arg= or the path); which tmux object that is gets
# decided here, by the same rules as `term` and `work`.
TITLE_OPT = "@fractal_title"
TITLE_LEN = 60


NOT_OURS, NOT_RUNNING = "not ours", "not running"


def title_target(arg: str) -> tuple[list[str], str] | str:
    """(scope flags, tmux target) holding the tab name for a terminal address,
    NOT_OURS for an address the server does not manage, NOT_RUNNING for one
    of ours with nothing running there (yet, or any more)."""
    names = {p.get("name") for p in registry().get("projects", [])}
    m = re.match(r"^pane:(\d+)$", arg)
    if m:
        # a pane opened from the session list: the name belongs to its window
        r = _tmux("display", "-p", "-t", "%" + m.group(1), "#{window_id}")
        return (["-w"], r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else NOT_RUNNING
    m = re.match(r"^([^:]+):([ps][1-9][0-9]?)$", arg)
    if m:
        own = term_owner(f"{m.group(1)}-{m.group(2)}", names)
        sess = f"{own[0]}-{own[1]}" if own else None
    elif arg in ("home", "~"):
        sess = "home"
    else:
        sess = arg if arg in names else None
    if not sess:
        return NOT_OURS
    if _tmux("has-session", "-t", "=" + sess).returncode != 0:
        return NOT_RUNNING
    # set/show-options take a target-PANE: "=sess" alone would be read as a
    # window name; "=sess:" is that session (its current window)
    return [], f"={sess}:"


def get_title(arg: str) -> tuple[str | None, str]:
    """(title, "") or (None, NOT_OURS / NOT_RUNNING)."""
    t = title_target(arg)
    if isinstance(t, str):
        return None, t
    if t[0] == ["-w"]:
        # a pane opened from the session list: its window's own name, else the
        # one its session got as an extra terminal (a format looks up both)
        r = _tmux("display", "-p", "-t", t[1], "#{" + TITLE_OPT + "}")
    else:
        r = _tmux("show-options", "-v", "-q", *t[0], "-t", t[1], TITLE_OPT)
    return r.stdout.rstrip("\n"), ""


def title_prefix(arg: str) -> str:
    """What the tab shows before a given name: the registry group of the
    terminal's project ("Work: chart fixes"), its name when it has no group,
    "" for home and panes outside projects."""
    names = {p.get("name") for p in registry().get("projects", [])}
    m = re.match(r"^pane:(\d+)$", arg)
    if m:
        r = _tmux("display", "-p", "-t", "%" + m.group(1), "#{session_name}")
        sess = r.stdout.strip() if r.returncode == 0 else ""
        own = term_owner(sess, names)
        name = own[0] if own else sess
    else:
        name = arg.split(":", 1)[0]
    p = project(name) if name in names else {}
    return (p.get("group") or p.get("name") or "") if p else ""


def set_title(arg: str, title: str) -> str:
    """"" when set, otherwise NOT_OURS / NOT_RUNNING / "failed"."""
    t = title_target(arg)
    if isinstance(t, str):
        return t
    title = "".join(c for c in title if c.isprintable()).strip()[:TITLE_LEN]
    if title:
        r = _tmux("set-option", *t[0], "-t", t[1], TITLE_OPT, title)
    else:
        r = _tmux("set-option", "-u", *t[0], "-t", t[1], TITLE_OPT)
    return "" if r.returncode == 0 else "failed"


def await_state(p, want_up: bool, grace: float) -> bool:
    deadline = time.monotonic() + grace
    while True:
        if port_open(p) == want_up:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.5)


def run_action(name: str, action: str, cmd: str, probe) -> None:
    """Runs in its own thread; the HTTP response does not wait for it.

    Success is NOT judged by the exit code. Control scripts are unreliable
    there (e.g. a stop that ends with "tmux kill-window" on a window that is
    already gone returns non-zero although the stop worked). The only honest
    answer to "did it work?" is the state of the port.
    """
    out = ""
    try:
        r = subprocess.run(shlex.split(cmd), capture_output=True, text=True,
                           timeout=ACTION_TIMEOUT, env=ENV, cwd=HOME)
        out = ((r.stdout or "") + (r.stderr or "")).strip()[-600:]   # the reason is at the end
    except subprocess.TimeoutExpired:
        out = f"command did not finish within {ACTION_TIMEOUT} s"
    except Exception as e:                                    # noqa: BLE001
        out = f"{type(e).__name__}: {e}"

    want_up = action == "start"
    # start: a dev server binds its port a while after launch; stop: the port
    # should vanish at once, waiting longer only delays the switch animation
    ok = await_state(probe, want_up, 45 if want_up else 10)
    if ok:
        msg = ""
    elif want_up:
        msg = f"port {probe} did not come up\n{out}".strip()
    else:
        msg = f"port {probe} is still open\n{out}".strip()

    with _lock:
        _busy.pop(name, None)
        _last[name] = {"ok": ok, "action": action, "msg": msg, "at": time.time()}


# --- agent window: quick send and headless query ------------------------------
# "send" pastes text into the interactive agent window of the project's tmux
# session (the same one the browser terminal attaches to), so the conversation
# can be continued there. "query" runs `claude -p` headless in the project
# directory; the answer is a job the dashboard polls, so long thinking never
# hits the nginx timeout.

def _tmux(*args: str, text_in: str | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(["tmux", *args], input=text_in,
                          capture_output=True, text=True, timeout=15, env=ENV)


def agent_target(name: str) -> str:
    # "=": exact session name - a bare "shop" would also match "shop-p1"
    # (an extra terminal) whenever the project session itself is not running
    return f"={name}:{AGENT_WINDOW}"


def pane_exists(target: str) -> bool:
    return _tmux("display", "-t", target, "-p", "").returncode == 0


def agent_running(target: str) -> bool:
    """Whether the agent really runs in the window.

    pane_current_command is useless: the agent starts through a shell wrapper
    ("claude -c ... || claude ...; exec bash") so tmux reports "bash" even
    while claude lives. Walk the process tree under pane_pid instead."""
    r = _tmux("display", "-t", target, "-p", "#{pane_pid}")
    if r.returncode != 0 or not r.stdout.strip().isdigit():
        return False
    root = int(r.stdout.strip())
    try:
        ps = subprocess.run(["ps", "-e", "-o", "pid=,ppid=,comm="],
                            capture_output=True, text=True, timeout=10).stdout
    except Exception:                                         # noqa: BLE001
        return False
    children: dict[int, list[int]] = {}
    comm: dict[int, str] = {}
    for line in ps.splitlines():
        f = line.split(None, 2)
        if len(f) < 3:
            continue
        pid, ppid = int(f[0]), int(f[1])
        children.setdefault(ppid, []).append(pid)
        comm[pid] = f[2]
    agent = CFG["FRACTAL_AGENT"]
    stack = [root]
    while stack:
        cur = stack.pop()
        if comm.get(cur, "").startswith((agent, "node")):
            return True
        stack.extend(children.get(cur, []))
    return False


def ensure_agent(name: str) -> str | None:
    """Make sure the agent runs in <name>:<window>. Session layout and command
    are the same as in the `work` script, only without attaching a terminal.
    Returns None or an error text."""
    p = project(name)
    if not p or p.get("terminal") is False:
        return f"project '{name}' has no terminal"
    root = p.get("root") or HOME
    cmd = agent_cmd(p.get("claudeArgs") or "")
    target = agent_target(name)

    if pane_exists(target):
        if agent_running(target):
            return None
        # window exists but the agent died into the fallback shell - respawn
        _tmux("respawn-window", "-k", "-t", target, cmd)
    elif _tmux("has-session", "-t", "=" + name).returncode == 0:
        _tmux("new-window", "-t", f"={name}:", "-n", AGENT_WINDOW, "-c", root, cmd)
    else:
        _tmux("new-session", "-d", "-s", name, "-n", AGENT_WINDOW, "-c", root, cmd)
        _tmux("new-window", "-t", f"={name}:", "-n", "shell", "-c", root)

    deadline = time.monotonic() + 45
    while time.monotonic() < deadline:
        if agent_running(target):
            time.sleep(3)   # the TUI needs a moment before it accepts input
            return None
        time.sleep(0.5)
    return f"agent in session '{name}' did not start within 45 s"


def agent_send(name: str, text: str) -> str | None:
    """Paste text into the agent window and press Enter. None or error."""
    err = ensure_agent(name)
    if err:
        return err
    # sendPrefix turns free text into e.g. "/braindump <text>"; text that is
    # itself a slash command ("/daily-brief") is meant literally
    text = text.strip()
    prefix = "" if text.startswith("/") else (project(name).get("sendPrefix") or "")
    r = _tmux("load-buffer", "-b", "fractal-send", "-", text_in=prefix + text)
    if r.returncode:
        return "load-buffer failed: " + r.stderr.strip()
    # -p = bracketed paste: newlines inside the text do NOT submit, Enter does
    r = _tmux("paste-buffer", "-p", "-d", "-b", "fractal-send", "-t", agent_target(name))
    if r.returncode:
        return "paste-buffer failed: " + r.stderr.strip()
    time.sleep(0.4)
    _tmux("send-keys", "-t", agent_target(name), "Enter")
    return None


def run_query(jid: str, name: str, q: str) -> None:
    """A project question: claude in the project root with its claudeArgs."""
    p = project(name)
    run_claude(jid, p.get("root") or HOME, shlex.split(p.get("claudeArgs") or ""), q)


def run_chat(jid: str, q: str, session: str, name: str) -> None:
    """A chat turn: claude in $HOME or in a project's root, continuing
    `session` when given (sessions belong to a directory, so the client keeps
    one per context)."""
    p = project(name) if name else {}
    extra = shlex.split(p.get("claudeArgs") or "") + ["--append-system-prompt", CHAT_PROMPT]
    if session:
        extra += ["--resume", session]
    run_claude(jid, p.get("root") or HOME, extra, q)


def run_claude(jid: str, root: str, extra: list[str], q: str) -> None:
    """Own thread; the client polls the result.

    The answer is STREAMED: claude runs with stream-json output and every text
    delta is appended to the job at once, so polling shows the answer while it
    is being written. The final "result" event replaces the text with the
    authoritative version. The session id of the run is kept in the job, so a
    chat can --resume it with the next message."""
    flags = shlex.split(CFG["FRACTAL_AGENT_FLAGS"])

    def put(text: str, done: bool = False, okv: bool = False) -> None:
        with _lock:
            j = _qjobs.get(jid)
            if j is None:
                return
            j["answer"] = text
            if done:
                j["done"], j["ok"], j["at"] = True, okv, time.time()

    def remember_session(obj: dict) -> None:
        sid = obj.get("session_id")
        if sid:
            with _lock:
                if jid in _qjobs:
                    _qjobs[jid]["session"] = sid

    if CFG["FRACTAL_AGENT"] != "claude":
        put("headless queries are only implemented for claude", done=True)
        return
    try:
        # question on stdin, not as an argument: claudeArgs may hold variadic
        # switches (--add-dir) that would swallow it. stderr to /dev/null - a
        # full pipe would block claude.
        proc = subprocess.Popen(
            ["claude", "-p", "--output-format", "stream-json",
             "--include-partial-messages", "--verbose", *flags, *extra],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, text=True, env=ENV, cwd=root)
        proc.stdin.write(q)
        proc.stdin.close()

        deadline = time.monotonic() + QUERY_TIMEOUT
        answer, new_block, got_result = "", False, False
        for line in proc.stdout:
            if time.monotonic() > deadline:
                proc.kill()
                put(f"no answer within {QUERY_TIMEOUT} s", done=True)
                return
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            t = obj.get("type")
            if t in ("system", "result"):
                remember_session(obj)
            if t == "stream_event":
                ev = obj.get("event") or {}
                if ev.get("type") == "content_block_start" \
                        and (ev.get("content_block") or {}).get("type") == "text":
                    new_block = True
                elif ev.get("type") == "content_block_delta":
                    d = (ev.get("delta") or {}).get("text")     # thinking_delta has no text
                    if d:
                        if new_block and answer:
                            answer += "\n\n"
                        new_block = False
                        answer += d
                        put(answer)
            elif t == "result":
                got_result = True
                final = (obj.get("result") or answer or "").strip()
                ok = not obj.get("is_error") and bool(final)
                put(final or "claude finished without an answer", done=True, okv=ok)

        proc.wait(timeout=30)
        if not got_result:
            put((answer or f"claude failed (exit {proc.returncode})").strip(), done=True)
    except Exception as e:                                    # noqa: BLE001
        put(f"{type(e).__name__}: {e}", done=True)


def run_hook(key: str, cmd: str, cwd: str) -> None:
    """Run a registry hook to completion and record the outcome."""
    t0 = time.monotonic()
    try:
        r = subprocess.run(shlex.split(cmd), capture_output=True, text=True,
                           timeout=HOOK_TIMEOUT, env=ENV, cwd=cwd)
        ok = r.returncode == 0
        msg = "done" if ok else (r.stderr.strip() or r.stdout.strip()
                                 or f"exit code {r.returncode}")[-400:]
    except subprocess.TimeoutExpired:
        ok, msg = False, f"did not finish within {HOOK_TIMEOUT} s"
    except Exception as e:                                    # noqa: BLE001
        ok, msg = False, f"{type(e).__name__}: {e}"
    with _lock:
        _hooks[key].update(running=False, ok=ok, msg=msg, at=time.time(),
                           took=int(time.monotonic() - t0))


class Handler(BaseHTTPRequestHandler):
    server_version = "fractal-ctl"

    def _send(self, code: int, payload: dict) -> None:
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json_body(self) -> dict | None:
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return None
        if n <= 0 or n > MAX_TEXT:
            return None
        try:
            return json.loads(self.rfile.read(n))
        except Exception:                                     # noqa: BLE001
            return None

    def do_GET(self) -> None:
        parts = [p for p in self.path.split("?")[0].split("/") if p]
        try:
            if not parts or parts == ["state"]:
                self._send(200, {"projects": snapshot(), "terms": term_windows()})
            elif parts == ["sessions"]:
                self._send(200, {"sessions": fractal_sessions.collect(), "now": time.time()})
            elif parts == ["term-title"]:
                q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
                # 404 = not ours (the page keeps the name itself), 409 = ours
                # but not running yet (the page asks again, never keeps it)
                t, why = get_title((q.get("arg") or [""])[0])
                if t is None:
                    self._send(404 if why == NOT_OURS else 409, {"error": why})
                else:
                    self._send(200, {"title": t, "prefix": title_prefix((q.get("arg") or [""])[0])})
            elif (len(parts) == 4 and parts[0] == "agent" and parts[2] == "query") \
                    or (len(parts) == 2 and parts[0] == "chat"):
                with _lock:
                    j = _qjobs.get(parts[-1])
                self._send(404, {"error": "unknown query"}) if j is None else self._send(200, j)
            elif len(parts) == 3 and parts[0] == "run":
                with _lock:
                    h = _hooks.get(f"{parts[1]}/{parts[2]}")
                self._send(200, dict(h) if h else {"running": False, "ok": None, "msg": "", "at": 0, "took": 0})
            else:
                self._send(404, {"error": "unknown endpoint"})
        except Exception as e:                                # noqa: BLE001
            self._send(500, {"error": f"registry: {e}"})

    def do_POST(self) -> None:
        parts = [p for p in self.path.split("?")[0].split("/") if p]
        try:
            if len(parts) == 3 and parts[0] == "agent":
                return self._agent(parts[1], parts[2])
            if parts == ["chat"]:
                body = self._json_body() or {}
                q = (body.get("q") or "").strip()
                session = str(body.get("session") or "")
                if not q:
                    return self._send(400, {"error": "empty message"})
                name = str(body.get("project") or "")
                if session and not re.fullmatch(r"[0-9a-f-]{36}", session):
                    return self._send(400, {"error": "session must be a session id"})
                if name and not project(name):
                    return self._send(404, {"error": f"unknown project '{name}'"})
                return self._send(202, {"id": self._new_job(run_chat, q, session, name)})
            if len(parts) == 3 and parts[0] == "run":
                return self._run(parts[1], parts[2])
            if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "summary":
                err = fractal_sessions.request_summary(parts[1])
                return self._send(404, {"error": err}) if err else self._send(202, {"ok": True})
            if parts == ["term-title"]:
                body = self._json_body() or {}
                why = set_title(str(body.get("arg") or ""), str(body.get("title") or ""))
                if not why:
                    return self._send(200, {"ok": True})
                return self._send({NOT_OURS: 404, NOT_RUNNING: 409}.get(why, 500), {"error": why})
            if len(parts) == 3 and parts[1] == "term" and parts[2] in ("p", "s"):
                win = new_term(parts[0], parts[2])
                return self._send(200, {"win": win}) if win else self._send(500, {"error": "could not create the terminal"})
            if len(parts) == 4 and parts[1] == "term" and parts[3] == "close":
                ok = close_term(parts[0], parts[2])
                return self._send(200, {"ok": True}) if ok else self._send(404, {"error": "no such terminal"})
            if len(parts) == 2:
                return self._toggle(parts[0], parts[1])
        except Exception as e:                                # noqa: BLE001
            return self._send(500, {"error": f"registry: {e}"})
        self._send(404, {"error": "expected /<project>/<start|stop>, /<project>/term/<p|s>, /<project>/term/<window>/close, /agent/<project>/<send|query> or /run/<project>/<hook>"})

    def _agent(self, name: str, what: str) -> None:
        if not project(name):
            return self._send(404, {"error": f"unknown project '{name}'"})
        body = self._json_body() or {}
        if what == "send":
            text = (body.get("text") or "").strip()
            if not text:
                return self._send(400, {"error": "empty text"})
            err = agent_send(name, text)     # blocks up to ~50 s if the session must start
            return self._send(500, {"error": err}) if err else self._send(200, {"ok": True})
        if what == "query":
            q = (body.get("q") or "").strip()
            if not q:
                return self._send(400, {"error": "empty question"})
            return self._send(202, {"id": self._new_job(run_query, name, q)})
        self._send(404, {"error": "agent verb must be send or query"})

    @staticmethod
    def _new_job(target, *args) -> str:
        jid = uuid.uuid4().hex[:12]
        now = time.time()
        with _lock:
            for k in [k for k, v in _qjobs.items() if v.get("done") and now - v["at"] > 3600]:
                _qjobs.pop(k)                                 # nobody collects hour-old jobs
            _qjobs[jid] = {"done": False, "ok": None, "answer": "", "at": now}
        threading.Thread(target=target, args=(jid, *args), daemon=True).start()
        return jid

    def _run(self, name: str, hook: str) -> None:
        p = project(name)
        cmd = (p.get("hooks") or {}).get(hook)
        if not cmd:
            # unknown project or hook - either way nothing is executed
            return self._send(404, {"error": f"project '{name}' has no hook '{hook}'"})
        key = f"{name}/{hook}"
        with _lock:
            if _hooks.get(key, {}).get("running"):
                return self._send(409, {"error": "already running"})
            _hooks[key] = {"running": True, "ok": None, "msg": "", "at": time.time(), "took": 0}
        threading.Thread(target=run_hook, args=(key, cmd, p.get("root") or HOME), daemon=True).start()
        self._send(202, {"ok": True})

    def _toggle(self, name: str, action: str) -> None:
        if action not in ("start", "stop"):
            return self._send(400, {"error": "action must be start or stop"})
        svc = services().get(name)
        if not svc:
            # unknown project or one without "service" - nothing runs either way
            return self._send(404, {"error": f"project '{name}' cannot be controlled"})
        with _lock:
            if name in _busy:
                return self._send(409, {"error": f"{_busy[name]['action']} already in progress"})
            _busy[name] = {"action": action, "since": time.time()}
        remember(name, action)
        threading.Thread(target=run_action,
                         args=(name, action, svc[action], svc["probe"]), daemon=True).start()
        self._send(202, {"ok": True, "project": name, "action": action})

    def log_message(self, fmt: str, *a) -> None:
        if self.command != "GET":          # the journal deserves actions, not every poll
            super().log_message(fmt, *a)


if __name__ == "__main__":
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
