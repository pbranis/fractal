#!/usr/bin/env python3
"""Browse ~ from the dashboard: list, download, upload.

Runs as the normal user on the loopback interface; nginx exposes it under
/files/ and restricts it to the tailnet (the whole home directory is behind
it). It is not nginx autoindex because a home directory is usually
drwx------, and opening it up to www-data just for browsing is wrong.

Endpoints (paths relative to ~):
    GET  /list?path=<rel>            directory listing as JSON
    GET  /dl?path=<rel>              download a file (attachment)
    PUT  /up?path=<dir>&name=<name>  upload into a directory

SECURITY: every client path is resolved through realpath and must stay
inside ~, otherwise 403. That kills both ".." and symlinks pointing out
(e.g. ~/link -> /etc). Writes only via /up, and an existing file is never
silently overwritten. Delete and rename are deliberately not implemented.
"""
import json
import mimetypes
import os
import re
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, unquote, urlparse

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from fractal_config import HOME, port  # noqa: E402

PORT = port("FILES")
MAX_BYTES = 4 * 1024**3          # same ceiling as /upload/
CHUNK = 1024 * 256


def resolve(rel: str) -> str | None:
    """Client path -> absolute path inside ~, or None."""
    rel = (rel or "").strip().lstrip("/")
    if "\x00" in rel:
        return None
    p = os.path.realpath(os.path.join(HOME, rel))
    if p != HOME and not p.startswith(HOME + os.sep):
        return None
    return p


def relative(path: str) -> str:
    return "" if path == HOME else os.path.relpath(path, HOME)


def safe_name(raw: str) -> str:
    """A file name only - no paths, no control characters."""
    name = os.path.basename(unquote(raw or "")).strip()
    name = re.sub(r"[\x00-\x1f\x7f]", "", name)
    name = name.lstrip(".") or "file"
    return name[:200]


def unique_path(dirpath: str, name: str) -> str:
    """Never silently overwrite an existing file."""
    base, ext = os.path.splitext(name)
    path, n = os.path.join(dirpath, name), 1
    while os.path.exists(path):
        path = os.path.join(dirpath, f"{base}-{n}{ext}")
        n += 1
    return path


def listing(dirpath: str) -> dict:
    """Directories first, then files; both by name, case-insensitive."""
    dirs, files = [], []
    with os.scandir(dirpath) as it:
        for e in it:
            try:
                is_dir = e.is_dir()
                s = e.stat()
                item = {"name": e.name, "dir": is_dir, "size": None if is_dir else s.st_size,
                        "mtime": time.strftime("%d.%m.%Y %H:%M", time.localtime(s.st_mtime)),
                        "link": e.is_symlink()}
            except OSError:
                # broken symlink or unreadable entry - do not fail the whole listing
                item = {"name": e.name, "dir": False, "size": None, "mtime": "", "link": e.is_symlink()}
            (dirs if item["dir"] else files).append(item)

    key = lambda x: x["name"].lower()                          # noqa: E731
    rel = relative(dirpath)
    return {"path": rel, "parent": None if not rel else os.path.dirname(rel),
            "entries": sorted(dirs, key=key) + sorted(files, key=key)}


class Handler(BaseHTTPRequestHandler):
    server_version = "fractal-files"

    def log_message(self, fmt, *args):
        if self.command != "GET":          # only writes go to the journal
            super().log_message(fmt, *args)

    def _send(self, code: int, body: bytes = b"", ctype: str = "text/plain; charset=utf-8") -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if body:
            self.wfile.write(body)

    def _json(self, code: int, payload: dict) -> None:
        self._send(code, json.dumps(payload, ensure_ascii=False).encode(), "application/json; charset=utf-8")

    def do_GET(self) -> None:
        u = urlparse(self.path)
        q = parse_qs(u.query)
        rel = (q.get("path") or [""])[0]
        route = u.path.rstrip("/")

        if route in ("/list", ""):
            p = resolve(rel)
            if p is None:
                return self._json(403, {"error": "path outside the home directory"})
            if not os.path.isdir(p):
                return self._json(404, {"error": "directory does not exist"})
            try:
                return self._json(200, listing(p))
            except OSError as e:
                return self._json(500, {"error": f"listing failed: {e}"})

        if route == "/dl":
            p = resolve(rel)
            if p is None:
                return self._send(403, b"path outside the home directory")
            if not os.path.isfile(p):
                return self._send(404, b"file does not exist")
            try:
                size = os.path.getsize(p)
                ctype = mimetypes.guess_type(p)[0] or "application/octet-stream"
                name = os.path.basename(p)
                self.send_response(200)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(size))
                self.send_header("Cache-Control", "no-store")
                # attachment: download, never render inside this origin
                self.send_header("Content-Disposition", "attachment; filename*=UTF-8''"
                                 + "".join(f"%{b:02X}" for b in name.encode()))
                self.end_headers()
                with open(p, "rb") as fh:
                    while chunk := fh.read(CHUNK):
                        self.wfile.write(chunk)
            except (OSError, BrokenPipeError):
                pass
            return

        self._json(404, {"error": "unknown endpoint"})

    def do_PUT(self) -> None:
        u = urlparse(self.path)
        q = parse_qs(u.query)
        if u.path.rstrip("/") != "/up":
            return self._send(404, b"unknown endpoint")

        d = resolve((q.get("path") or [""])[0])
        if d is None:
            return self._send(403, b"path outside the home directory")
        if not os.path.isdir(d):
            return self._send(404, b"target directory does not exist")

        name = safe_name((q.get("name") or [""])[0])
        try:
            length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            return self._send(400, b"bad Content-Length")
        if length <= 0:
            return self._send(400, b"empty body")
        if length > MAX_BYTES:
            return self._send(413, b"file too large")

        path = unique_path(d, name)
        tmp = path + ".part"
        try:
            remaining = length
            with open(tmp, "wb") as fh:
                while remaining > 0:
                    chunk = self.rfile.read(min(CHUNK, remaining))
                    if not chunk:
                        break
                    fh.write(chunk)
                    remaining -= len(chunk)
            if remaining:                        # connection dropped
                os.unlink(tmp)
                return self._send(400, b"incomplete transfer")
            os.rename(tmp, path)
        except OSError as e:
            if os.path.exists(tmp):
                os.unlink(tmp)
            return self._send(500, f"write failed: {e}".encode())

        self._send(201, os.path.basename(path).encode())


if __name__ == "__main__":
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
