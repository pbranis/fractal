#!/usr/bin/env python3
"""Drop-zone backend: uploads into $FRACTAL_UPLOADS (default ~/uploads).

Runs as the normal user on the loopback interface; nginx exposes it under
/upload/ and restricts it to the tailnet. Not plain nginx because the home
directory is drwx------ and www-data must not write there.

Transfer is a PUT whose body is the file, not multipart. No multipart parser
needed (the cgi module is gone since Python 3.13) and the browser can send
the file object directly: fetch(name, {method: "PUT", body: file}).

    GET  /            minimal stand-alone upload page
    GET  /_list       JSON list of uploaded files
    PUT  /<name>      store a file (never overwrites; -1, -2 ... suffixes)
"""
import json
import os
import re
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import unquote

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from fractal_config import CFG, port  # noqa: E402

DEST = CFG["FRACTAL_UPLOADS"]
PORT = port("UPLOAD")
MAX_BYTES = 4 * 1024**3          # 4 GB ceiling so a mistake cannot fill the disk
CHUNK = 1024 * 256

os.makedirs(DEST, exist_ok=True)


def safe_name(raw: str) -> str:
    name = os.path.basename(unquote(raw or "")).strip()
    name = re.sub(r"[\x00-\x1f\x7f]", "", name)
    name = name.lstrip(".") or "file"
    return name[:200]


def unique_path(name: str) -> str:
    base, ext = os.path.splitext(name)
    path, n = os.path.join(DEST, name), 1
    while os.path.exists(path):
        path = os.path.join(DEST, f"{base}-{n}{ext}")
        n += 1
    return path


PAGE = """<!doctype html>
<html lang="cs"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>fractal — nahrát soubory</title>
<style>
 :root{--bg:#f9f9f7;--card:#fcfcfb;--border:#e1e0d9;--text:#0b0b0b;
       --text2:#52514e;--muted:#898781;--accent:#2a78d6;--chip:#f0efec;
       --good:#0ca30c;--crit:#d03b3b}
 @media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
       --bg:#0d0d0d;--card:#1a1a19;--border:#2c2c2a;--text:#fff;
       --text2:#c3c2b7;--muted:#898781;--accent:#3987e5;--chip:#232321}}
 *{box-sizing:border-box}
 body{margin:0;background:var(--bg);color:var(--text);
      font:15px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif;
      padding:32px 20px 64px}
 .wrap{max-width:640px;margin:0 auto}
 h1{font-size:22px;margin:0 0 4px;letter-spacing:-.02em}
 .sub{color:var(--text2);font-size:13.5px;margin-bottom:22px}
 .sub a{color:var(--accent)}
 #drop{border:2px dashed var(--border);border-radius:12px;background:var(--card);
       padding:38px 20px;text-align:center;transition:.15s;cursor:pointer}
 #drop.over{border-color:var(--accent);background:var(--chip)}
 #drop strong{display:block;font-size:16px;margin-bottom:4px}
 #drop span{color:var(--muted);font-size:13px}
 input[type=file]{display:none}
 ul{list-style:none;margin:18px 0 0;padding:0}
 li{display:flex;gap:10px;align-items:center;padding:9px 12px;background:var(--card);
    border:1px solid var(--border);border-radius:8px;margin-bottom:8px;font-size:13.5px}
 .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
 .st{margin-left:auto;font-size:12px;color:var(--muted);white-space:nowrap}
 .st.ok{color:var(--good)} .st.err{color:var(--crit)}
 .bar{height:4px;background:var(--chip);border-radius:2px;overflow:hidden;
      width:90px;margin-left:auto}
 .bar i{display:block;height:100%;background:var(--accent);width:0;transition:.2s}
 h2{font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);
    margin:26px 0 8px}
</style></head><body><div class="wrap">
<h1>Nahrát soubory</h1>
<div class="sub">Uloží se do <code>__DEST__</code> · <a href="/">rozcestník</a></div>
<div id="drop">
  <strong>Přetáhni soubory sem</strong>
  <span>nebo klikni a vyber</span>
  <input type="file" id="pick" multiple>
</div>
<ul id="queue"></ul>
<h2>Už nahráno</h2>
<ul id="have"></ul>
<script>
const drop=document.getElementById('drop'), pick=document.getElementById('pick'),
      queue=document.getElementById('queue'), have=document.getElementById('have');
drop.onclick=()=>pick.click();
pick.onchange=()=>{send([...pick.files]); pick.value='';};
['dragenter','dragover'].forEach(e=>drop.addEventListener(e,ev=>{ev.preventDefault(); drop.classList.add('over');}));
['dragleave','drop'].forEach(e=>drop.addEventListener(e,ev=>{ev.preventDefault(); drop.classList.remove('over');}));
drop.addEventListener('drop',ev=>send([...ev.dataTransfer.files]));
function fmt(b){const u=['B','kB','MB','GB'];let i=0;while(b>=1024&&i<u.length-1){b/=1024;i++}return b.toFixed(i?1:0)+' '+u[i];}
function send(files){
  for(const f of files){
    const li=document.createElement('li');
    const nm=document.createElement('span'); nm.className='nm'; nm.textContent=f.name+' ('+fmt(f.size)+')';
    const bar=document.createElement('div'); bar.className='bar';
    const fill=document.createElement('i'); bar.appendChild(fill);
    li.append(nm,bar); queue.appendChild(li);
    const x=new XMLHttpRequest();          // XHR for upload progress
    x.open('PUT', encodeURIComponent(f.name));
    x.upload.onprogress=e=>{ if(e.lengthComputable) fill.style.width=(e.loaded/e.total*100)+'%'; };
    x.onload=()=>{ bar.remove(); const st=document.createElement('span'); st.className='st';
      if(x.status===201){ st.classList.add('ok'); st.textContent='nahráno'; refresh(); }
      else { st.classList.add('err'); st.textContent='chyba '+x.status; }
      li.appendChild(st); };
    x.onerror=()=>{ bar.remove(); const st=document.createElement('span'); st.className='st err'; st.textContent='selhalo'; li.appendChild(st); };
    x.send(f);
  }
}
async function refresh(){
  try{
    const r=await fetch('_list',{cache:'no-store'}); const files=await r.json();
    have.innerHTML = files.length ? '' : '<li style="color:var(--muted)">zatím nic</li>';
    for(const f of files){ const li=document.createElement('li');
      const nm=document.createElement('span'); nm.className='nm'; nm.textContent=f.name;
      const st=document.createElement('span'); st.className='st'; st.textContent=fmt(f.size)+' · '+f.mtime;
      li.append(nm,st); have.appendChild(li); }
  }catch(e){}
}
refresh();
</script></div></body></html>
""".replace("__DEST__", DEST.replace(os.path.expanduser("~"), "~"))


class Handler(BaseHTTPRequestHandler):
    server_version = "fractal-upload"

    def log_message(self, fmt, *args):          # quiet; nothing here deserves the journal
        pass

    def _send(self, code, body=b"", ctype="text/plain; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if body:
            self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?")[0]
        if path in ("/", ""):
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        elif path == "/_list":
            items = []
            for n in sorted(os.listdir(DEST)):
                p = os.path.join(DEST, n)
                if os.path.isfile(p):
                    s = os.stat(p)
                    items.append({"name": n, "size": s.st_size,
                                  "mtime": time.strftime("%d.%m. %H:%M", time.localtime(s.st_mtime))})
            self._send(200, json.dumps(items).encode(), "application/json")
        else:
            self._send(404, b"not found")

    def do_PUT(self):
        name = safe_name(self.path.lstrip("/"))
        try:
            length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            return self._send(400, b"bad Content-Length")
        if length <= 0:
            return self._send(400, b"empty body")
        if length > MAX_BYTES:
            return self._send(413, b"file too large")

        path = unique_path(name)
        tmp = path + ".part"
        try:
            remaining = length
            with open(tmp, "wb") as fh:
                while remaining > 0:
                    chunk = self.rfile.read(min(CHUNK, remaining))
                    if not chunk:
                        break
                    fh.write(chunk)
                    remaining -= len(chunk)
            if remaining:
                os.unlink(tmp)
                return self._send(400, b"incomplete transfer")
            os.rename(tmp, path)
        except OSError as e:
            if os.path.exists(tmp):
                os.unlink(tmp)
            return self._send(500, f"write failed: {e}".encode())

        self._send(201, os.path.basename(path).encode())


if __name__ == "__main__":
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
