#!/bin/bash
# term - what ttyd runs behind /term/. The project comes from the URL: /term/?arg=myproject
# (or /term/?arg=myproject:p2 for an extra terminal, see below)
#
# The name is ALWAYS checked against the registry. Without that, the url-arg
# would let anyone run an arbitrary command through the URL - and there is a
# shell behind this endpoint.
set -u
. "$(dirname "$(readlink -f "$0")")/../lib/fractal-env.sh"
REG="$FRACTAL_REGISTRY"

list() {
    echo "Projects:"
    jq -r '.projects[] | "  " + .name + "  — " + .title' "$REG" 2>/dev/null
}

name="${1:-}"

if [ -z "$name" ]; then
    echo "fractal terminal"; echo
    list; echo
    read -rp "project (Enter = plain shell): " name
    [ -z "$name" ] && exec bash -l
fi

# Reserved name "home": a plain shell in ~ inside tmux session "home". Not a
# project, so no registry check - nothing from the URL is executed, a shell
# just opens.
if [ "$name" = home ] || [ "$name" = "~" ]; then
    tmux has-session -t home 2>/dev/null || tmux new-session -d -s home -c "$HOME"
    exec tmux attach -t home
fi

# "pane:<n>": attach to an existing tmux pane %<n> (the session list on the
# dashboard links every agent this way). Only digits are accepted and the pane
# must already exist - this opens what runs, it never starts anything. A
# grouped session (new-session -t) is used so the other clients of that
# session keep their own current window; it dies with the browser tab.
if [[ "$name" == pane:* ]]; then
    id="${name#pane:}"
    if [[ "$id" =~ ^[0-9]+$ ]] && sess=$(tmux display -p -t "%$id" '#{session_name}' 2>/dev/null); then
        win=$(tmux display -p -t "%$id" '#{window_id}')
        exec tmux new-session -t "$sess" \; set-option destroy-unattached on \
            \; select-window -t "$win" \; select-pane -t "%$id"
    fi
    echo "That session is gone (pane %$id no longer exists)."; echo
    list; echo
    echo "Continuing with a plain shell."; echo
    exec bash -l
fi

# "<project>:p<n>" / "<project>:s<n>": an extra terminal of the project (a new
# agent conversation, or a shell) - its own tmux session "<project>-p<n>".
# The dashboard creates it first (POST /ctl/<project>/term/p, which picks the
# number); this only attaches. A closed one is not brought back: an old
# browser tab reconnecting, or a link to p3 after p3 was closed, would
# otherwise start a new conversation under the old address and tab name.
# Only that exact shape gets through; `work` checks it again.
win=""
if [[ "$name" =~ ^([^:]+):([ps][1-9][0-9]?)$ ]]; then
    name="${BASH_REMATCH[1]}"; win="${BASH_REMATCH[2]}"
fi

if ! jq -e --arg n "$name" '.projects[] | select(.name==$n)' "$REG" >/dev/null 2>&1; then
    echo "Unknown project: '$name'"; echo
    list; echo
    echo "Continuing with a plain shell."; echo
    exec bash -l
fi

if [ -n "$win" ]; then
    if ! tmux has-session -t "=$name-$win" 2>/dev/null; then
        echo "Terminal $name-$win is not running (closed, or never created)."
        echo "Open a new one with ＋ on the dashboard - reload the dashboard first if it"
        echo "has been open for a while (an old page opens this address directly)."; echo
        echo "Continuing with a plain shell."; echo
        exec bash -l
    fi
    exec work "$name" "$win"
fi
exec work "$name"
