# fractal configuration - copied to ~/.config/fractal/fractal.env by install.sh.
# Plain KEY=VALUE; read by the bash scripts, the Python scripts and install.sh
# (which renders the values into systemd units and nginx snippets). Every key
# has a sensible default, so you can delete what you do not change.

# Web root served by nginx. Owned by YOU, not root - that is what makes
# adding a project a plain file write.
FRACTAL_WWW=/var/www/fractal

# Public base URL, used in printed hints and the 403 page. Put the address
# you actually type into the browser here (MagicDNS name, LAN name, ...).
FRACTAL_URL=http://devbox/

# Networks allowed to reach shells and personal content (/term, /ctl, /files,
# /upload). Space separated CIDRs. Default = Tailscale's ranges. The plain
# dashboard is visible from anywhere that reaches port 80.
FRACTAL_ALLOW="100.64.0.0/10 fd7a:115c:a1e0::/48"

# Where the dashboard drop zone stores files.
FRACTAL_UPLOADS=~/uploads

# Autostart memory and backups.
FRACTAL_STATE_DIR=~/.config/fractal

# Loopback ports of the helper services (nginx proxies them). Change only if
# they collide with something; run install.sh --nginx afterwards.
FRACTAL_CTL_PORT=7691
FRACTAL_FILES_PORT=7692
FRACTAL_UPLOAD_PORT=7690
FRACTAL_TERM_PORT=7685

# Coding agent started in the first tmux window of every project.
# FRACTAL_AGENT=claude enables "resume in this directory" and the headless
# "ask" box on pinned projects. Any other command is started as-is.
# The default flags skip permission prompts - read SECURITY.md before you
# keep that on a machine other people can reach.
FRACTAL_AGENT=claude
FRACTAL_AGENT_FLAGS="--dangerously-skip-permissions"
FRACTAL_AGENT_WINDOW=claude

# Wireless interface for the Wi-Fi tile; empty = first wireless interface found.
FRACTAL_WIFI_IFACE=

# Telegram bot (optional). Control the dashboard from a chat: /status, /start,
# /stop, /run, /send, /ask. Space separated NUMERIC Telegram user IDs that may
# talk to the bot; while empty the bot only replies with the sender's ID.
# The bot token is NOT here: `fractal-telegram configure <token>` writes it to
# FRACTAL_TELEGRAM_TOKEN_FILE with mode 0600. install.sh enables the service
# once that file exists. FRACTAL_TELEGRAM_WATCH = seconds between checks that
# notify you when a project dies or comes back on its own (0 = off).
FRACTAL_TELEGRAM_USERS=
FRACTAL_TELEGRAM_TOKEN_FILE=~/.config/fractal/telegram-token
FRACTAL_TELEGRAM_WATCH=60
